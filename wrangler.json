{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  "name": "mybackhurts-landing",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "mybackhurts.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
